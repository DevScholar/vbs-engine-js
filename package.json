{
  "name": "@devscholar/vbs-engine-js",
  "description": "A VBScript engine written in TypeScript",
  "version": "1.1.2",
  "type": "module",
  "main": "dist/vbs-engine.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "DevScholar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devscholar/vbs-engine-js.git"
  },
  "bugs": {
    "url": "https://github.com/devscholar/vbs-engine-js/issues"
  },
  "homepage": "https://github.com/devscholar/vbs-engine-js#readme",
  "keywords": [
    "vbs",
    "vbscript",
    "internetexplorer",
    "internet-explorer",
    "ie"
  ],
  "exports": {
    ".": {
      "import": "./dist/vbs-engine.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepublishOnly": "npm run build && node scripts/pre-publish.js",
    "postpublish": "node scripts/post-publish.js",
    "preview": "vite preview",
    "test": "node --experimental-transform-types --experimental-vm-modules node_modules/vitest/vitest.mjs",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@devscholar/node-ps1-dotnet": "file:../node-with-series/node-ps1-dotnet"
  }
}
